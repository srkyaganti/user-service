{
  "name": "user-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "docker-compose up -d && bun run --hot apps/api/src/index.ts",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "bun run --cwd packages/database generate",
    "build:apps": "bun build apps/api/src/index.ts --target=bun --outdir=dist",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate": "bun run --cwd packages/database migrate",
    "db:generate": "bun run --cwd packages/database generate",
    "db:push": "bun run --cwd packages/database push",
    "db:studio": "bun run --cwd packages/database studio",
    "docker:build": "docker build -t user-service:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@hono/node-server": "^1.8.2",
    "@hono/swagger-ui": "^0.2.1",
    "@hono/zod-openapi": "^0.9.0",
    "@hono/prometheus": "^1.0.0",
    "graphql-yoga": "^5.1.1",
    "ioredis": "^5.3.2",
    "bullmq": "^5.4.0",
    "zod": "^3.22.4",
    "jose": "^5.2.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "@simplewebauthn/server": "^10.0.0",
    "otpauth": "^9.2.2",
    "argon2": "^0.31.2",
    "sharp": "^0.33.2",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.9.8",
    "qrcode": "^1.5.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.3",
    "@biomejs/biome": "^1.5.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "@types/node": "^20.11.24"
  }
}
